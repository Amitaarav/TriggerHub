# .env.example — Copy to .env and fill in values

# ─── Database ───────────────────────────────────────
POSTGRES_USER=youruser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=triggerhub
DATABASE_URL=postgresql://youruser:yourpassword@db:5432/triggerhub

# ─── Kafka ──────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ─── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth (primBackend) — REQUIRED, min 32 chars ───
JWT_SECRET=change-me-to-a-random-32-char-string!!
JWT_REFRESH_SECRET=change-me-to-another-random-32-chars!!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ──────────────────────────────────────
AADHAR_SALT=change-me-to-a-random-32-char-salt!!!!

# ─── Optional ──────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# EMAIL_SENDER=
# RESEND_API_KEY=
# APP_ORIGIN=http://localhost:3000
# APP_NAME=TriggerHub
